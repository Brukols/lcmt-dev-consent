# Predefined service descriptions
msgid "Tag container used to load analytics and advertising scripts."
msgstr "Conteneur de tags utilisé pour charger des scripts d'analyse et de publicité."

msgid "Used to generate site-traffic statistics."
msgstr "Utilisé pour générer des statistiques de fréquentation du site."

msgid "Used to track user actions on Facebook."
msgstr "Utilisé pour suivre les actions des utilisateurs sur Facebook."

msgid "Used to track user actions on the site."
msgstr "Utilisé pour suivre les actions des utilisateurs sur le site."

# Google Consent Mode v2 virtual services
msgid "Google analytics storage"
msgstr "Stockage analytique (Google)"

msgid "Used to store and access cookies for analytics purposes, to measure site activity and performance."
msgstr "Utilisé pour stocker et accéder aux cookies à des fins d'analyse, permettant de mesurer l'activité et la performance du site."

msgid "Google ad storage"
msgstr "Stockage publicitaire (Google)"

msgid "Used to store and access cookies for advertising purposes, such as conversion tracking and remarketing."
msgstr "Utilisé pour stocker et accéder aux cookies à des fins publicitaires, comme le suivi des conversions et le remarketing."

msgid "Google ad user data"
msgstr "Données utilisateur publicitaires (Google)"

msgid "Used to send user data to Google to improve ad relevance."
msgstr "Utilisé pour envoyer des données utilisateur à Google pour améliorer la pertinence des annonces."

msgid "Google ad personalization"
msgstr "Personnalisation des annonces (Google)"

msgid "Used to store cookies enabling ad personalization based on past user interactions."
msgstr "Utilisé pour stocker des cookies permettant la personnalisation des annonces en fonction des interactions passées de l'utilisateur."

msgid "Use Google Consent Mode v2"
msgstr "Utiliser Google Consent Mode v2"

msgid "When enabled, GTM loads on every page with all 4 consent signals denied by default. The banner shows 4 individual toggles (analytics_storage, ad_storage, ad_user_data, ad_personalization) instead of one GTM toggle."
msgstr "Lorsqu'activé, GTM se charge sur chaque page avec les 4 signaux de consentement refusés par défaut. La bannière affiche 4 bascules individuelles (analytics_storage, ad_storage, ad_user_data, ad_personalization) à la place d'une seule bascule GTM."

# YouTube service + placeholder
msgid "Used to embed videos hosted on YouTube. Accepting allows YouTube/Google to set cookies on your device."
msgstr "Utilisé pour intégrer des vidéos hébergées sur YouTube. Accepter permet à YouTube/Google de déposer des cookies sur votre appareil."

msgid "This content is hosted on YouTube"
msgstr "Ce contenu est hébergé sur YouTube"

msgid "Loading it will set cookies from YouTube/Google. Accept to play the video."
msgstr "Le charger déposera des cookies de YouTube/Google. Acceptez pour lire la vidéo."

msgid "Accept and play"
msgstr "Accepter et lire"

msgid "YouTube video player"
msgstr "Lecteur vidéo YouTube"
