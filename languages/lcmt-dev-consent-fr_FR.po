msgstr "Accepter"

msgid "Refuse"
msgstr "Refuser"

msgid "All accept"
msgstr "Tout accepter"

msgid "All refuse"
msgstr "Tout refuser"

msgid "Cookies management panel"
msgstr "Panneau de gestion des cookies"

msgid "Learn more"
msgstr "En savoir plus"

# Categories — default names + descriptions
msgid "APIs"
msgstr "APIs"

msgid "APIs allow scripts to be loaded: geolocation, search engines, translations, etc."
msgstr "Les APIs permettent de charger des scripts : géolocalisation, moteurs de recherche, traductions, etc."

msgid "Audience measurement"
msgstr "Mesure d'audience"

msgid "Audience-measurement cookies generate statistics about site traffic and usage. This data helps us improve the site."
msgstr "Les cookies de mesure d'audience permettent de générer des statistiques de fréquentation et d'utilisation de ce site. Ces données nous aident à améliorer le contenu de notre site."

msgid "Advertising"
msgstr "Règles publicitaires"

msgid "Advertising cookies allow targeted ads to be served."
msgstr "Les cookies publicitaires permettent de proposer des publicités ciblées."

