msgstr "Registre de consentement"

msgid "Retention"
msgstr "Durée de conservation"

msgid "Enable consent logging"
msgstr "Activer la journalisation des consentements"

msgid "Record an auditable proof of each consent event"
msgstr "Conserver une preuve auditable de chaque consentement"

msgid "Retention (months)"
msgstr "Durée de conservation (mois)"

msgid "Records older than this are deleted daily. Default 36 months."
msgstr "Les enregistrements plus anciens sont supprimés quotidiennement. Par défaut 36 mois."

msgid "Records"
msgstr "Enregistrements"

msgid "Consent ID"
msgstr "Identifiant de consentement"

msgid "All events"
msgstr "Tous les évènements"

msgid "Date (UTC)"
msgstr "Date (UTC)"

msgid "Event"
msgstr "Évènement"

msgid "Choices"
msgstr "Choix"

msgid "Policy"
msgstr "Politique"

msgid "No records."
msgstr "Aucun enregistrement."

msgid "Filter"
msgstr "Filtrer"

msgid "Export CSV (current filter)"
msgstr "Exporter en CSV (filtre actuel)"

